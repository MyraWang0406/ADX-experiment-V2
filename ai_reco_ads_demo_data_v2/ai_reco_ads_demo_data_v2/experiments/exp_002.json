        "evidence_fields": [
          "pipeline.reasons.*.auction",
          "breakdown.by_hour.*.fill_rate"
        ],
        "actions": [
          "提高出价/ocpx 倍率或放宽目标",
          "检查预算节奏（pacing）是否过早打光",
          "降低链路延迟与超时率"
        ]
      },
      {
        "name": "质量/相关性不足（误杀/噪声）",
        "checks": [
          "FILTERED_BY_QUALITY",
          "after_fine 缩小",
          "CTR 下滑"
        ],
        "evidence_fields": [
          "pipeline.funnel",
          "pipeline.reasons.*.rerank",
          "metrics_summary.*.guardrails"
        ],
        "actions": [
          "补充特征/样本，或调整多目标权重",
          "增加/修复召回源（提升候选多样性）",
          "加白名单/冷启动保护策略"
        ]
      },
      {
        "name": "体验护栏受损",
        "checks": [
          "早退率上升",
          "次日留存下滑",
          "投诉率上升"
        ],
        "evidence_fields": [
          "metrics_summary.*.guardrails"
        ],
        "actions": [
          "调整频控/多样性/重复惩罚",
          "分人群切实验，先护住敏感人群"
        ]
      },
      {
        "name": "oCPX 控制不稳",
        "checks": [
          "Multiplier 波动",
          "实际 CPA 偏离"
        ],
        "evidence_fields": [
          "pipeline.ocpx_timeseries"
        ],
        "actions": [
          "调整 ocpx multiplier 上限/下限",
          "拆时段建模（午高峰/晚高峰）",
          "增加稳定性正则/平滑"
        ]
      }
    ]
  },
